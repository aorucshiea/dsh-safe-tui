{
  "name": "@dsh-external/dsh-safe-console",
  "version": "0.1.0",
  "description": "DeepSeek Harness safe-mode recovery console: minimal interactive terminal, no user plugins/presets, built-in repair",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aorucshiea/dsh-safe-console.git"
  },
  "homepage": "https://github.com/aorucshiea/dsh-safe-console",
  "bugs": {
    "url": "https://github.com/aorucshiea/dsh-safe-console/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "safe-mode",
    "recovery",
    "tui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./repair": {
      "default": "./lib/repair.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "pristine/**/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-headless": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6"
  },
  "license": "MIT"
}
